
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Credentials (Supports both new Secret/Publishable Keys and legacy Service/Anon Keys)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
# Format Baru (Supabase 2024/2025+)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
# Atau Format Legacy JWT:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Secret for Admin Authentication
JWT_SECRET=askara-super-secret-jwt-key-2026-pt-askara-tekno-pangan
